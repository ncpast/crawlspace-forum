---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getThread } from "../../../lib/boards";
import ReplyForm from "../../../components/ReplyForm";

const {board, publicId} = Astro.params;
const thread = board && publicId ? await getThread(board, publicId) : null;

if (!thread) {
    Astro.response.status = 404;
}
const replyIds = new Set((thread?.replies ?? []).map((r) => String(r.id)));

function parseContent(text: string) {
    const parts: { text: string; ref?: string }[] = [];
    const re = /RE: ([\w-]+)/g;
    let last = 0;
    for (const m of text.matchAll(re)) {
        if (!replyIds.has(m[1])) continue;
        if (m.index! > last) parts.push({ text: text.slice(last, m.index) });
        parts.push({ text: m[0], ref: m[1] });
        last = m.index! + m[0].length;
    }
    if (last < text.length) parts.push({ text: text.slice(last) });
    return parts;
}
---

<BaseLayout title={thread ? `${thread.title} - /${board}/` : "Thread not found"}>
    {thread ? (
        <>
            <article>
                <div class="op" id="op">
                    <h1>{thread.title} <span class="id">#{thread.id}</span></h1>
                    <p style="font-size: 120%;"><b>{thread.author}</b></p>
                    <p>{thread.content}</p>
                </div>
                {thread.replies.map((r, i) => (
                    <div class="reply" id={`reply-${r.id}`}>
                        <p>
                            <a class="reply-num" href={`#reply-${r.id}`}><span class="id">#{r.id}</span></a>
                            <b>{r.author}</b>
                            <button type="button" class="reply-btn" data-reply-to={r.id}>Reply</button>
                        </p>
                        <p>{parseContent(r.content).map((p) => p.ref ? <a class="reply-ref" href={`#reply-${p.ref}`}>{p.text}</a> : p.text)}</p>
                    </div>
                ))}
            </article>

            <div id="reply-form" style="margin-top: 20px;">
                <ReplyForm client:load slug={board!} publicId={publicId!} />
            </div>
        </>
    ) : (
        <p>Thread not found. <a href={`/${board}/`}>Back to /{board}/</a></p>
    )}
</BaseLayout>

<style>
    .id {
        color: var(--accent);
        opacity: 0.7;
    }
</style>

<script>
    document.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-reply-to]");
        if (!btn) return;
        window.dispatchEvent(
            new CustomEvent("reply-to", { detail: { id: btn.dataset.replyTo } })
        );
        document.getElementById("reply-form")?.scrollIntoView({ behavior: "smooth" });
    });
</script>