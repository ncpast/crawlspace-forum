---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getBoard, getThreads } from "../../lib/boards";
import NewPostForm from "../../components/NewPostForm";
import { RateLimitError } from "../../lib/api";

const { board: slug } = Astro.params;

let board: Awaited<ReturnType<typeof getBoard>> = null;
let threads: NonNullable<Awaited<ReturnType<typeof getThreads>>> = [];
let rateLimited = false;
try {
    board = slug ? await getBoard(slug) : null;
    threads = board ? (await getThreads(board.slug)) ?? [] : [];
} catch (e) {
    if (e instanceof RateLimitError) rateLimited = true;
    else throw e;
}

if (rateLimited) Astro.response.status = 429;
else if (!board) Astro.response.status = 404;
---

<BaseLayout
    title={rateLimited ? "Too many requests" : board ? `/${slug}/ - ${board.name}` : "Board not found"}
>
    {rateLimited ? (
        <div class="empty-state">
            <h2>Slow down</h2>
            <p>Too many requests, try again in a minute.</p>
            <a href={Astro.url.pathname}>⟳ Try again</a>
        </div>
    ) : board ? (
        <>
            <div class="page-heading">
                <h1>
                    <span class="board-slug">{"/" + board.slug + "/"}</span>
                    <span class="accent" style="color: var(--text);">{board.name}</span>
                </h1>

                <p>{board.description}</p>
            </div>

            <div class="main">
                <section class="boards">
                    <NewPostForm client:load slug={board.slug}/>
                    <div class="thread-list">
                        {threads.map((t) => (
                            <a
                                class="thread-card"
                                href={`/${board.slug}/thread/${t.publicId}`}
                            >
                                <h3>{t.title}</h3>

                                <div class="thread-meta">
                                    <span>by {t.author}</span>
                                    <span>{t.replyCount} replies</span>
                                </div>
                            </a>
                        ))}
                    </div>

                    {threads.length === 0 && (
                        <div class="empty-state">
                            No threads yet. Be the first to post!
                        </div>
                    )}
                </section>

                <aside class="popular">
                    <div class="side-card">
                        <h3>About this board</h3>
                        <p>{board.description}</p>
                    </div>

                    <div class="side-card">
                        <h3>Statistics</h3>
                        <p>
                            {threads.length} threads available.
                        </p>
                    </div>

                    <div class="side-card">
                        <h3>House rules</h3>
                        <p>
                            Keep it civil. No spam or illegal content.
                        </p>
                    </div>
                </aside>
            </div>
        </>
    ) : (
        <div class="empty-state">
            <h2>Board not found</h2>
            <p>
                There is no board called /{slug}/.
            </p>
            <a href="/">← Back to boards</a>
        </div>
    )}
</BaseLayout>