---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getBoards } from "../lib/boards";
import { RateLimitError } from "../lib/api";

let boards: Awaited<ReturnType<typeof getBoards>> = [];
let rateLimited = false;
try {
    boards = await getBoards();
} catch (e) {
    if (e instanceof RateLimitError) rateLimited = true;
    else throw e;
}

if (rateLimited) Astro.response.status = 429;
---

<BaseLayout>
    <div class="page-heading">
        ...unchanged...
    </div>

    {rateLimited ? (
        <div class="empty-state">
            <h2>Slow down</h2>
            <p>Too many requests, try again in a minute.</p>
            <a href={Astro.url.pathname}>⟳ Try again</a>
        </div>
    ) : (
        <>
            <section class="board-grid">...unchanged...</section>

            {boards.length === 0 && (
                <div class="empty-state">No boards available yet.</div>
            )}

            <h3 class="section-title">Latest bumps</h3>
            <div class="bump-list">
                <div class="bump-empty">No threads yet.</div>
            </div>
        </>
    )}
</BaseLayout>