---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getBoards } from "../lib/boards";

const boards = await getBoards();

// console.log(boards);
---

<BaseLayout>
    <div class="main">
        <div class="boards">
            <ul style="list-style-type: none;">
                {boards.map((board) => (<li ><a href={`/${board.slug}/`}>.{board.name}</a></li>))}
            </ul>
        </div>
        <div class="popular">
            <p>Lorem ipsum dolor sit, amet consectetur adipisicing elit. Inventore dicta nisi quos dolor exercitationem modi consectetur quasi molestiae blanditiis et, voluptate facere dolorum itaque voluptatibus beatae sapiente odit, hic perspiciatis!</p>
        </div>
    </div>
    
</BaseLayout>

<style>
    .main {
        display: flex;
        gap: 1rem;
    }

    .boards {
        flex: 0 0 30%;
    }
    .popular {
        flex: 1;
    }

    .main div {
        padding: 0 15px;
        border-style: solid;
        border-radius: 15px;
        border-color: var(--accent);
        border-width: 2px;
    }
</style>